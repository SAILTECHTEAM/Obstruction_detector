{
  "rabbitmq": {
    "host": "rabbitmq.example.internal",
    "port": 5671,
    "virtual_host": "/",
    "username_env": "ALARM_RABBITMQ_USERNAME",
    "password_env": "ALARM_RABBITMQ_PASSWORD",
    "tls": {"enabled": true, "ca_certificate": "/etc/ssl/certs/rabbitmq-ca.pem", "verify_server": true},
    "input_queue": "alarm.inference",
    "output_queue": "alarm.depth-analysis",
    "dead_letter_exchange": "alarm.dlx",
    "dead_letter_queue": "alarm.inference.dead",
    "heartbeat": 300,
    "max_retries": 5,
    "reconnect_initial_seconds": 1,
    "reconnect_max_seconds": 60,
    "prefetch_count": 1
  },
  "sftp": {
    "host": "sftp.example.internal",
    "port": 22,
    "username": "alarm-reader",
    "password": "replace-me",
    "remote_base_path": "/alarm-images",
    "timeout_seconds": 30,
    "max_image_bytes": 26214400
  },
  "camera_config": "camera_config.json",
  "local_state_dir": "alarm_worker_state",
  "health_host": "127.0.0.1",
  "health_port": 8088,
  "depth_model": {"model_dir": "depth-anything/DA3METRIC-LARGE", "device": "cuda", "process_res": 504},
  "hyperparameters": {"person_yolo_id": 1, "depth_threshold_m": 0.2, "min_front_fraction": 0.6, "erode_pixels": 5, "min_valid_pixels": 100, "patch_size": 15, "distance_threshold_m": 1.5}
}
